---
// Astroコンポーネント用ファイル
---

<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>ニーズリスト</title>
    <link rel="stylesheet" href="../../style.css">
</head>
<body>

    <div class="container">
        <header>
            <h1>ニーズリスト作成</h1>
            <div>
                <button class="btn btn-secondary" onclick="window.resetToDefault()">初期化</button>
            </div>
        </header>

        <div class="card">
            <div class="card-title">ステークホルダの追加</div>
            <div class="form-row">
                <input type="text" id="new-top-category-input" class="input-flex" placeholder="例: 運営スタッフ, スポンサー, 来場者">
                <button class="btn btn-primary" onclick="window.addTopCategory()">追加</button>
            </div>
        </div>

        <div class="card">
            <div class="card-title">現在のニーズリスト</div>
            <div id="tree-root" class="tree-container">データを読み込み中...</div>
        </div>

        <div class="footer-bar">
            <div>
                <span id="data-status" style="font-size: 0.85rem; color: #718096;">変更内容は自動保存されています</span>
            </div>
            <button class="btn btn-success" onclick="window.saveAndNavigate()">確定して表（出力画面）を出力 →</button>
        </div>
    </div>

<script>
    type NeedsData = Record<string, string[] | Record<string, string[]>>;

    const defaultData: NeedsData = {
        // 必要に応じて初期データを設定してください
    };

    let needsData: NeedsData = {};

    function init(): void {
        const saved = localStorage.getItem('seat_needs_data');
        if (saved) {
            try {
                needsData = JSON.parse(saved);
            } catch (e) {
                needsData = JSON.parse(JSON.stringify(defaultData));
            }
        } else {
            needsData = JSON.parse(JSON.stringify(defaultData));
        }
        renderTree();
    }

    function autoSave(): void {
        localStorage.setItem('seat_needs_data', JSON.stringify(needsData));
        const statusEl = document.getElementById('data-status');
        if (statusEl) {
            statusEl.innerText = "変更をローカルに保存しました (" + new Date().toLocaleTimeString() + ")";
        }
    }

    function renderTree(): void {
        const root = document.getElementById('tree-root');
        if (!root) return;

        const topKeys = Object.keys(needsData);

        if (topKeys.length === 0) {
            root.innerHTML = '<p style="color: #a0aec0; text-align: center; padding: 20px;">ステークホルダが登録されていません。上のフォームから追加してください。</p>';
            return;
        }

        let html = '';

        topKeys.forEach(topKey => {
            const val = needsData[topKey];
            const isArray = Array.isArray(val);

            html += `
                <div class="top-category-block">
                    <div class="top-category-header">
                        <span> ${escapeHtml(topKey)}</span>
                        <div>
                            ${isArray ? `<button class="btn btn-secondary" style="font-size: 0.75rem; padding: 3px 8px; margin-right: 5px;" onclick="window.convertToGroup('${escapeHtml(topKey)}')">サブカテゴリを追加</button>` : ''}
                            <button class="btn btn-danger" onclick="window.deleteTopCategory('${escapeHtml(topKey)}')">削除</button>
                        </div>
                    </div>
            `;

            if (isArray) {
                html += `<div style="padding: 10px 15px;">`;
                html += renderItemsList(val as string[], [topKey]);
                html += renderAddInlineForm([topKey], "＋ ニーズを追加");
                html += `</div>`;
            } else if (typeof val === 'object' && val !== null) {
                const subObj = val as Record<string, string[]>;
                const subKeys = Object.keys(subObj);
                
                subKeys.forEach(subKey => {
                    const items = subObj[subKey] || [];
                    html += `
                        <div class="sub-category-block">
                            <div class="sub-category-header">
                                <span>└ ${escapeHtml(subKey)}</span>
                                <button class="btn btn-danger" onclick="window.deleteSubCategory('${escapeHtml(topKey)}', '${escapeHtml(subKey)}')">削除</button>
                            </div>
                            ${renderItemsList(items, [topKey, subKey])}
                            ${renderAddInlineForm([topKey, subKey], "＋ ニーズを追加")}
                        </div>
                    `;
                });

                html += `
                    <div style="padding: 10px 15px; background-color: #faf5ff; border-top: 1px dashed #d6bcfa;">
                        <div class="add-inline-form">
                            <input type="text" id="add-sub-${escapeHtml(topKey)}" class="input-flex" placeholder="＋ サブカテゴリを追加 (例: 若年層, VIP)" onkeydown="if(event.key==='Enter') window.addSubCategory('${escapeHtml(topKey)}')">
                            <button class="btn btn-primary" style="font-size: 0.8rem;" onclick="window.addSubCategory('${escapeHtml(topKey)}')">追加</button>
                        </div>
                    </div>
                `;
            }

            html += `</div>`;
        });

        root.innerHTML = html;
    }

    function renderItemsList(items: string[], path: string[]): string {
        if (!items || items.length === 0) {
            return '<p style="font-size: 0.8rem; color: #a0aec0; margin: 4px 0;">(ニーズ項目なし)</p>';
        }
        let html = '<ul class="items-list">';
        items.forEach((item, idx) => {
            const pathStr = JSON.stringify(path).replace(/"/g, '&quot;');
            html += `
                <li>
                    <span>・ ${escapeHtml(item)}</span>
                    <button class="btn btn-danger" onclick='window.deleteNeedItem(${pathStr}, ${idx})'>×</button>
                </li>
            `;
        });
        html += '</ul>';
        return html;
    }

    function renderAddInlineForm(path: string[], placeholder: string): string {
        const pathId = path.join('___');
        const pathStr = JSON.stringify(path).replace(/"/g, '&quot;');
        return `
            <div class="add-inline-form">
                <input type="text" id="input-${pathId}" class="input-flex" placeholder="${placeholder}" onkeydown='if(event.key==="Enter") window.addNeedItem(${pathStr})'>
                <button class="btn btn-secondary" style="font-size: 0.8rem;" onclick='window.addNeedItem(${pathStr})'>追加</button>
            </div>
        `;
    }

    function addTopCategory(): void {
        const input = document.getElementById('new-top-category-input') as HTMLInputElement | null;
        if (!input) return;
        const name = input.value.trim();
        if (!name) return;
        if (needsData[name]) {
            alert('既に存在するステークホルダ名です。');
            return;
        }
        needsData[name] = [];
        input.value = '';
        autoSave();
        renderTree();
    }

    function deleteTopCategory(topKey: string): void {
        if (confirm(`「${topKey}」とその下のデータをすべて削除しますか？`)) {
            delete needsData[topKey];
            autoSave();
            renderTree();
        }
    }

    function addSubCategory(topKey: string): void {
        const input = document.getElementById(`add-sub-${topKey}`) as HTMLInputElement | null;
        if (!input) return;
        const subName = input.value.trim();
        if (!subName) return;

        if (Array.isArray(needsData[topKey])) {
            needsData[topKey] = {};
        }
        const topVal = needsData[topKey] as Record<string, string[]>;
        if (!topVal[subName]) {
            topVal[subName] = [];
        }
        input.value = '';
        autoSave();
        renderTree();
    }

    function deleteSubCategory(topKey: string, subKey: string): void {
        if (confirm(`サブカテゴリ「${subKey}」を削除しますか？`)) {
            const topVal = needsData[topKey] as Record<string, string[]>;
            if (topVal) {
                delete topVal[subKey];
            }
            autoSave();
            renderTree();
        }
    }

    function convertToGroup(topKey: string): void {
        needsData[topKey] = {};
        autoSave();
        renderTree();
    }

    function addNeedItem(path: string[]): void {
        const pathId = path.join('___');
        const input = document.getElementById(`input-${pathId}`) as HTMLInputElement | null;
        if (!input) return;
        const text = input.value.trim();
        if (!text) return;

        if (path.length === 1) {
            (needsData[path[0]] as string[]).push(text);
        } else if (path.length === 2) {
            const topVal = needsData[path[0]] as Record<string, string[]>;
            topVal[path[1]].push(text);
        }

        input.value = '';
        autoSave();
        renderTree();

        setTimeout(() => {
            const el = document.getElementById(`input-${pathId}`) as HTMLInputElement | null;
            if (el) el.focus();
        }, 50);
    }

    function deleteNeedItem(path: string[], idx: number): void {
        if (path.length === 1) {
            (needsData[path[0]] as string[]).splice(idx, 1);
        } else if (path.length === 2) {
            const topVal = needsData[path[0]] as Record<string, string[]>;
            topVal[path[1]].splice(idx, 1);
        }
        autoSave();
        renderTree();
    }

    function resetToDefault(): void {
        if (confirm('初期データにリセットしますか？現在の編集内容は上書きされます。')) {
            needsData = JSON.parse(JSON.stringify(defaultData));
            autoSave();
            renderTree();
        }
    }

    function saveAndNavigate(): void {
        localStorage.setItem('seat_needs_data', JSON.stringify(needsData));
        window.location.href = 'output.html';
    }

    function escapeHtml(str: unknown): string {
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;');
    }

    declare global {
        interface Window {
            convertToGroup: typeof convertToGroup;
            deleteTopCategory: typeof deleteTopCategory;
            deleteSubCategory: typeof deleteSubCategory;
            addSubCategory: typeof addSubCategory;
            addNeedItem: typeof addNeedItem;
            deleteNeedItem: typeof deleteNeedItem;
            addTopCategory: typeof addTopCategory;
            resetToDefault: typeof resetToDefault;
            saveAndNavigate: typeof saveAndNavigate;
        }
    }

    window.convertToGroup = convertToGroup;
    window.deleteTopCategory = deleteTopCategory;
    window.deleteSubCategory = deleteSubCategory;
    window.addSubCategory = addSubCategory;
    window.addNeedItem = addNeedItem;
    window.deleteNeedItem = deleteNeedItem;
    window.addTopCategory = addTopCategory;
    window.resetToDefault = resetToDefault;
    window.saveAndNavigate = saveAndNavigate;

    init();
</script>

</body>
</html>