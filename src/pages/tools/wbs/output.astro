---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import '../../../styles/style.css';
import '../../../styles/wbs.css';
---

<BaseLayout title="作業一覧表">
    <div class="container container-wide">
        <header>
            <div>
                <h1>作業一覧表（WBS）</h1>
                <div class="subtitle">プロジェクトの作業一覧・先行作業・所要時間</div>
            </div>
            <a class="btn btn-secondary" href="/tools/wbs/">← 編集に戻る</a>
        </header>

        <div class="card">
            <div class="output-toolbar">
                <button type="button" class="btn btn-secondary" id="download-svg-btn">SVG で保存</button>
                <button type="button" class="btn btn-secondary" id="download-png-btn">PNG で保存</button>
                <button type="button" class="btn btn-secondary" id="copy-tsv-btn">TSV (Excel用) コピー</button>
                <button type="button" class="btn btn-secondary" id="copy-md-btn">Markdown コピー</button>
                <button type="button" class="btn btn-secondary" id="print-btn">印刷</button>
            </div>
            <div id="table-container">データを読み込み中...</div>
        </div>
    </div>
</BaseLayout>

<script>
    import { initWbsOutput } from '../../../scripts/wbs/output';

    initWbsOutput();
</script>
