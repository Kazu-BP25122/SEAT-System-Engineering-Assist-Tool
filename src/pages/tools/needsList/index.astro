---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Workspace from '../../../components/Workspace.astro';
import '../../../styles/style.css';
import '../../../styles/needsList.css';
---

<BaseLayout title="ニーズリスト">
    <div class="container container-wide">
        <header>
            <div>
                <h1>ニーズリスト作成</h1>
                <div class="subtitle">ステークホルダとそのニーズを整理して一覧表を作成します</div>
            </div>
            <div>
                <button class="btn btn-secondary" id="reset-btn">初期化</button>
            </div>
        </header>

        <Workspace previewLabel="表">
            <Fragment slot="editor">
                <div class="card">
                    <div class="card-title">ステークホルダの追加</div>
                    <div class="form-row">
                        <input type="text" id="new-top-category-input" class="input-flex" placeholder="例: 運営スタッフ, スポンサー, 来場者">
                        <button class="btn btn-primary" id="add-top-category-btn">追加</button>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">現在のニーズリスト</div>
                    <div id="tree-root" class="tree-container">データを読み込み中...</div>
                </div>
            </Fragment>

            <Fragment slot="preview">
                <div class="card">
                    <div class="card-title">ニーズリスト（プレビュー）</div>
                    <div id="table-preview" class="table-preview-container">データを読み込み中...</div>
                </div>
            </Fragment>
        </Workspace>

        <div class="footer-bar">
            <div>
                <span id="data-status" class="status-text">変更内容は自動保存されています</span>
            </div>
            <button class="btn btn-success" id="save-navigate-btn">確定して表（出力画面）を出力 →</button>
        </div>
    </div>
</BaseLayout>

<script>
    import { initNeedsList } from '../../../scripts/needsList/input';

    initNeedsList();
</script>
