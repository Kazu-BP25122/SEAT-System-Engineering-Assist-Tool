---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiagramPanel from '../../../components/DiagramPanel.astro';
import Workspace from '../../../components/Workspace.astro';
import '../../../styles/style.css';
import '../../../styles/needsList.css';
import '../../../styles/ahp.css';
---

<BaseLayout title="AHP階層図">
    <div class="container container-wide">
        <header>
            <div>
                <h1>AHP階層図 作成</h1>
                <div class="subtitle">総合目的・評価基準（ステークホルダ / ニーズ）・代替案から階層図を作成します</div>
            </div>
            <div>
                <button class="btn btn-secondary" id="reset-btn">初期化</button>
            </div>
        </header>

        <Workspace>
            <Fragment slot="editor">
                <div class="card">
                    <div class="card-title">総合目的</div>
                    <input type="text" id="goal-input" class="ahp-goal-input" placeholder="例: 文化祭の模擬店で出すメニューを決める">
                </div>

                <div class="card">
                    <div class="card-title">ステークホルダとニーズ（評価基準）</div>
                    <div class="form-row">
                        <input type="text" id="new-stakeholder-input" class="input-flex" placeholder="例: 運営スタッフ, スポンサー, 来場者">
                        <button class="btn btn-primary" id="add-stakeholder-btn">追加</button>
                    </div>
                    <button class="btn btn-secondary ahp-import-btn" id="import-needs-btn">ニーズリストから読み込む</button>
                    <div id="stakeholder-root" class="tree-container">データを読み込み中...</div>

                    <div class="ahp-mode">
                        <span class="ahp-mode-title">評価基準として並べる項目:</span>
                        <label><input type="radio" name="criteria-mode" value="stakeholder"> ステークホルダ</label>
                        <label><input type="radio" name="criteria-mode" value="need"> ニーズ項目</label>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title">代替案</div>
                    <div class="form-row">
                        <input type="text" id="new-alternative-input" class="input-flex" placeholder="例: ポップコーン, スムージー">
                        <button class="btn btn-primary" id="add-alternative-btn">追加</button>
                    </div>
                    <div id="alternative-root">データを読み込み中...</div>
                </div>
            </Fragment>

            <Fragment slot="preview">
                <div class="card">
                    <div class="card-title">AHP階層図（プレビュー）</div>
                    <DiagramPanel id="ahp-preview" />
                </div>
            </Fragment>
        </Workspace>

        <div class="footer-bar">
            <div>
                <span id="data-status" class="status-text">変更内容は自動保存されています</span>
            </div>
            <button class="btn btn-success" id="save-navigate-btn">確定して階層図（出力画面）を出力 →</button>
        </div>
    </div>
</BaseLayout>

<script>
    import { initAhpInput } from '../../../scripts/ahp/input';

    initAhpInput();
</script>
