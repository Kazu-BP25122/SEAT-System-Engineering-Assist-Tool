---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DiagramPanel from '../../../components/DiagramPanel.astro';
import Workspace from '../../../components/Workspace.astro';
import '../../../styles/style.css';
import '../../../styles/needsList.css';
import '../../../styles/ahp.css';
---

<BaseLayout title="AHP階層図">
    <div class="container container-wide">
        <header>
            <div>
                <h1>AHP階層図 作成</h1>
                <div class="subtitle">総合目的・評価基準（3 層）または大基準・中基準（4 層）・代替案から階層図を作成します</div>
            </div>
            <div>
                <button class="btn btn-secondary" id="reset-btn">初期化</button>
            </div>
        </header>

        <Workspace>
            <Fragment slot="editor">
                <div class="card">
                    <div class="card-title">総合目的</div>
                    <input type="text" id="goal-input" class="ahp-goal-input" placeholder="例: 文化祭の模擬店で出すメニューを決める">
                </div>

                <div class="card">
                    <div class="card-title">階層の数</div>
                    <div class="ahp-mode" role="radiogroup" aria-label="階層の数">
                        <label><input type="radio" name="hierarchy-levels" value="3"> 3 層（総合目的 → 評価基準 → 代替案）</label>
                        <label><input type="radio" name="hierarchy-levels" value="4"> 4 層（総合目的 → 大基準 → 中基準 → 代替案）</label>
                    </div>
                </div>

                <div class="card">
                    <div class="card-title" id="criteria-title">評価基準</div>
                    <div class="form-row">
                        <input type="text" id="new-criterion-input" class="input-flex" placeholder="例: 味, 提供の速さ, 利益">
                        <button class="btn btn-primary" id="add-criterion-btn">追加</button>
                    </div>
                    <button class="btn btn-secondary ahp-import-btn" id="import-needs-btn">ニーズリストから読み込む</button>
                    <div id="criteria-root" class="tree-container">データを読み込み中...</div>
                </div>

                <div class="card">
                    <div class="card-title">代替案</div>
                    <div class="form-row">
                        <input type="text" id="new-alternative-input" class="input-flex" placeholder="例: ポップコーン, スムージー">
                        <button class="btn btn-primary" id="add-alternative-btn">追加</button>
                    </div>
                    <div id="alternative-root">データを読み込み中...</div>
                </div>
            </Fragment>

            <Fragment slot="preview">
                <div class="card">
                    <div class="card-title">AHP階層図（プレビュー）</div>
                    <DiagramPanel id="ahp-preview" />
                </div>
            </Fragment>
        </Workspace>

        <div class="footer-bar">
            <div>
                <span id="data-status" class="status-text">変更内容は自動保存されています</span>
            </div>
            <button class="btn btn-success" id="save-navigate-btn">確定して階層図（出力画面）を出力 →</button>
        </div>
    </div>
</BaseLayout>

<script>
    import { initAhpInput } from '../../../scripts/ahp/input';

    initAhpInput();
</script>
