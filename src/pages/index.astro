---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/style.css';

// tools ディレクトリ内の各ツールの index.astro を自動探索
const toolFiles = import.meta.glob<string>('./tools/*/index.astro', {
    query: '?raw',
    import: 'default',
    eager: true,
});

// 各ツールのファイル内容からパスとタイトルを取得
const tools = Object.entries(toolFiles).map(([filePath, content]) => {
    const matchTool = filePath.match(/\.\/tools\/([^/]+)\/index\.astro/);
    const toolId = matchTool ? matchTool[1] : '';

    // <BaseLayout title="..."> からタイトル名を取得（なければ <h1> またはディレクトリ名）
    const titleMatch =
        content.match(/<BaseLayout[^>]*\btitle=["']([^"']+)["']/i) ??
        content.match(/<BaseLayout[^>]*\btitle=\{["']([^"']+)["']\}/i) ??
        content.match(/<h1[^>]*>([^<]+)<\/h1>/i);
    const title = titleMatch ? titleMatch[1].trim() : toolId;

    return {
        id: toolId,
        title,
        href: `/tools/${toolId}/`,
    };
});

// ツールID順にソート
tools.sort((a, b) => a.id.localeCompare(b.id));
---

<BaseLayout title="SEAT - System Engineering Assist Tool">
    <div class="container">
        <header>
            <div>
                <h1>SEAT</h1>
                <div class="subtitle">System Engineering Assist Tool - システム工学の図表を作成</div>
            </div>
        </header>

        <div class="card">
            <div class="card-title">ツール一覧</div>
            {tools.length > 0 ? (
                <ul class="tool-list">
                    {tools.map((tool) => (
                        <li class="tool-item">
                            <div class="tool-info">
                                <div class="tool-name">{tool.title}</div>
                            </div>
                            <a href={tool.href} class="btn btn-primary">作成画面へ →</a>
                        </li>
                    ))}
                </ul>
            ) : (
                <p>利用可能なツールはありません。</p>
            )}
        </div>
    </div>
</BaseLayout>
