---
// AHP階層図の表示領域と保存・コピー用ツールバー。
// 描画はクライアント側で mountAhpDiagram(要素) が返す関数にデータを渡して行う。
interface Props {
    id: string;
}

const { id } = Astro.props;
---

<div class="ahp-diagram" id={id}>
    <div class="ahp-toolbar">
        <button type="button" class="btn btn-secondary" data-ahp-action="download-svg">SVG で保存</button>
        <button type="button" class="btn btn-secondary" data-ahp-action="download-png">PNG で保存</button>
        <button type="button" class="btn btn-secondary" data-ahp-action="copy-mermaid">Mermaid コードをコピー</button>
    </div>
    <div class="ahp-canvas" data-ahp-canvas>図を生成中...</div>
</div>
